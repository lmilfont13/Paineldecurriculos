generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Company {
  id             String   @id @default(cuid())
  name           String
  slug           String   @unique
  email          String
  cnpj           String?
  sector         String?
  website        String?
  primaryColor   String   @default("#1E4FBF")
  secondaryColor String   @default("#0E7A6B")
  /// Símbolo quadrado: cabeçalho, ícone da aba, e-mails.
  logoUrl        String?
  /// Logo completo (com o nome): topo da página de vagas e login.
  logoFullUrl    String?
  heroTitle      String   @default("Trabalhe com a gente")
  heroSubtitle   String   @default("Crie sua conta uma vez e candidate-se em um clique.")
  aboutText      String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  users        User[]
  jobs         Job[]
  formFields   FormField[]
  applications Application[]
}

model User {
  id        String   @id @default(cuid())
  companyId String?
  email     String   @unique
  name      String?
  role      Role     @default(MANAGER)
  createdAt DateTime @default(now())
  company   Company? @relation(fields: [companyId], references: [id])
}

enum Role {
  ADMIN
  MANAGER
}

model Job {
  id           String    @id @default(cuid())
  companyId    String
  title        String
  description  String
  requirements String?
  location     String?
  contract     Contract  @default(CLT)
  workMode     WorkMode  @default(REMOTE)
  status       JobStatus @default(DRAFT)
  aiCriteria   String[]  @default([])
  aiMinScore   Int       @default(70)
  /// Quando a vaga entrou no ar pela última vez ("publicada há X dias").
  publishedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  company      Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  applications Application[]
}

enum Contract {
  CLT
  PJ
  FREELANCE
  INTERNSHIP
}

enum WorkMode {
  REMOTE
  HYBRID
  ONSITE
}

enum JobStatus {
  DRAFT
  OPEN
  PAUSED
  CLOSED
}

model FormField {
  id        String    @id @default(cuid())
  companyId String
  label     String
  type      FieldType
  required  Boolean   @default(false)
  options   String[]  @default([])
  order     Int
  isCore    Boolean   @default(false)

  company Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  answers Answer[]
}

enum FieldType {
  SHORT_TEXT
  LONG_TEXT
  DROPDOWN
  YES_NO
  NUMBER
  DATE
  FILE_UPLOAD
}

model Candidate {
  id        String   @id @default(cuid())
  authId    String?  @unique
  email     String   @unique
  name      String
  phone     String?
  resumeUrl String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  applications  Application[]
  notifications Notification[]
}

model Application {
  id           String    @id @default(cuid())
  jobId        String
  companyId    String
  candidateId  String?
  name         String
  email        String
  phone        String?
  resumeUrl    String?
  status       AppStatus @default(PENDING)
  aiState      AIState   @default(WAITING)
  aiScore      Int?
  aiReasoning  String?
  managerNotes String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  /// Conversa combinada. Uma rodada por candidatura — se um dia houver mais
  /// de uma etapa de entrevista, isto vira um modelo próprio.
  interviewAt       DateTime?
  interviewMode     String? // "Videochamada" | "Presencial" | "Telefone"
  interviewLocation String? // link da chamada, endereço ou telefone

  job           Job            @relation(fields: [jobId], references: [id], onDelete: Cascade)
  company       Company        @relation(fields: [companyId], references: [id])
  candidate     Candidate?     @relation(fields: [candidateId], references: [id])
  answers       Answer[]
  statusEvents  StatusEvent[]
  notifications Notification[]

  @@unique([candidateId, jobId])
}

/// Novidade do processo na visão do candidato — o mesmo evento que vira
/// trilha e e-mail. Nunca carrega score, raciocínio da IA ou notas do gestor.
model Notification {
  id            String           @id @default(cuid())
  candidateId   String
  applicationId String?
  type          NotificationType
  title         String
  body          String?
  readAt        DateTime?
  createdAt     DateTime         @default(now())

  candidate   Candidate    @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  application Application? @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([candidateId, readAt])
}

enum NotificationType {
  APPLICATION_RECEIVED
  STAGE_CHANGED
  INTERVIEW_SCHEDULED
  MANAGER_MESSAGE
  RESULT
  NEW_JOB
}

/// Trilha de mudanças de status — histórico p/ gestor, timeline p/ candidato.
model StatusEvent {
  id            String     @id @default(cuid())
  applicationId String
  from          AppStatus?
  to            AppStatus
  actor         String // "candidato" | "gestor" | "sistema"
  createdAt     DateTime   @default(now())

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
}

enum AppStatus {
  PENDING
  INTERVIEW
  APPROVED
  REJECTED
}

enum AIState {
  WAITING
  PROCESSING
  DONE
  FAILED
  NO_RESUME
}

model Answer {
  id            String @id @default(cuid())
  applicationId String
  fieldId       String
  value         String

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  field       FormField   @relation(fields: [fieldId], references: [id])
}
