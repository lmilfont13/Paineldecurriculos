generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Company {
  id             String   @id @default(cuid())
  name           String
  slug           String   @unique
  email          String
  cnpj           String?
  sector         String?
  website        String?
  primaryColor   String   @default("#1E4FBF")
  secondaryColor String   @default("#0E7A6B")
  logoUrl        String?
  heroTitle      String   @default("Trabalhe com a gente")
  heroSubtitle   String   @default("Candidate-se em minutos, sem criar conta.")
  aboutText      String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  users        User[]
  jobs         Job[]
  formFields   FormField[]
  applications Application[]
}

model User {
  id        String   @id @default(cuid())
  companyId String?
  email     String   @unique
  name      String?
  role      Role     @default(MANAGER)
  createdAt DateTime @default(now())
  company   Company? @relation(fields: [companyId], references: [id])
}

enum Role {
  ADMIN
  MANAGER
}

model Job {
  id           String    @id @default(cuid())
  companyId    String
  title        String
  description  String
  requirements String?
  location     String?
  contract     Contract  @default(CLT)
  workMode     WorkMode  @default(REMOTE)
  status       JobStatus @default(DRAFT)
  aiCriteria   String[]  @default([])
  aiMinScore   Int       @default(70)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  company      Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  applications Application[]
}

enum Contract {
  CLT
  PJ
  FREELANCE
  INTERNSHIP
}

enum WorkMode {
  REMOTE
  HYBRID
  ONSITE
}

enum JobStatus {
  DRAFT
  OPEN
  PAUSED
  CLOSED
}

model FormField {
  id        String    @id @default(cuid())
  companyId String
  label     String
  type      FieldType
  required  Boolean   @default(false)
  options   String[]  @default([])
  order     Int
  isCore    Boolean   @default(false)

  company Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  answers Answer[]
}

enum FieldType {
  SHORT_TEXT
  LONG_TEXT
  DROPDOWN
  YES_NO
  NUMBER
  DATE
  FILE_UPLOAD
}

model Application {
  id          String    @id @default(cuid())
  jobId       String
  companyId   String
  name        String
  email       String
  phone       String?
  resumeUrl   String?
  status      AppStatus @default(PENDING)
  aiState     AIState   @default(WAITING)
  aiScore     Int?
  aiReasoning String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  job     Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  company Company  @relation(fields: [companyId], references: [id])
  answers Answer[]
}

enum AppStatus {
  PENDING
  INTERVIEW
  APPROVED
  REJECTED
}

enum AIState {
  WAITING
  PROCESSING
  DONE
  FAILED
  NO_RESUME
}

model Answer {
  id            String @id @default(cuid())
  applicationId String
  fieldId       String
  value         String

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  field       FormField   @relation(fields: [fieldId], references: [id])
}
