generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Company {
  id             String   @id @default(cuid())
  name           String
  slug           String   @unique
  /// E-mail da empresa: para onde vão as respostas dos candidatos aos e-mails do sistema.
  email          String
  /// Remetente dos e-mails (opcional): precisa ser de um domínio verificado no Resend.
  senderEmail    String?
  cnpj           String?
  sector         String?
  website        String?
  primaryColor   String   @default("#1E4FBF")
  secondaryColor String   @default("#0E7A6B")
  /// Símbolo quadrado: cabeçalho, ícone da aba, e-mails.
  logoUrl        String?
  /// Logo completo (com o nome): topo da página de vagas e login.
  logoFullUrl    String?
  heroTitle      String   @default("Trabalhe com a gente")
  heroSubtitle   String   @default("Crie sua conta uma vez e candidate-se em um clique.")
  aboutText      String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  users         User[]
  jobs          Job[]
  formFields    FormField[]
  applications  Application[]
  auditLogs     AuditLog[]
  agentRuns     AgentRun[]
  talentFolders TalentFolder[]
  messageTemplates MessageTemplate[]
}

model User {
  id        String   @id @default(cuid())
  companyId String?
  email     String   @unique
  name      String?
  role      Role     @default(MANAGER)
  createdAt DateTime @default(now())
  company   Company? @relation(fields: [companyId], references: [id])

  @@index([companyId])
}

enum Role {
  ADMIN
  MANAGER
}

model Job {
  id             String    @id @default(cuid())
  companyId      String
  /// Código da vaga (ex.: "1123"), exibido ao candidato para diferenciar vagas do mesmo cargo.
  code           String?
  title          String
  description    String
  requirements   String?
  location       String?
  contract       Contract  @default(CLT)
  workMode       WorkMode  @default(REMOTE)
  status         JobStatus @default(DRAFT)
  aiCriteria     String[]  @default([])
  aiMinScore     Int       @default(70)
  whatsappShares Int       @default(0)
  /// Quando a vaga entrou no ar pela última vez ("publicada há X dias").
  publishedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  company       Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  applications  Application[]
  formFields    FormField[]
  talentMatches TalentMatch[]

  @@index([companyId, status])
}

enum Contract {
  CLT
  PJ
  FREELANCE
  INTERNSHIP
}

enum WorkMode {
  REMOTE
  HYBRID
  ONSITE
}

enum JobStatus {
  DRAFT
  OPEN
  PAUSED
  CLOSED
}

model FormField {
  id        String    @id @default(cuid())
  companyId String
  label     String
  type      FieldType
  required  Boolean   @default(false)
  options   String[]  @default([])
  order     Int
  isCore    Boolean   @default(false)
  /// null = pergunta da empresa (todas as vagas); preenchido = só desta vaga.
  jobId     String?

  company Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  job     Job?     @relation(fields: [jobId], references: [id], onDelete: Cascade)
  answers Answer[]

  @@index([companyId, order])
  @@index([jobId])
}

enum FieldType {
  SHORT_TEXT
  LONG_TEXT
  DROPDOWN
  YES_NO
  NUMBER
  DATE
  FILE_UPLOAD
}

model Candidate {
  id        String   @id @default(cuid())
  authId    String?  @unique
  email     String   @unique
  name      String
  phone     String?
  resumeUrl String?

  /// Dados essenciais para triagem e busca sem redundância com o currículo:
  birthDate         DateTime?
  city              String?
  state             String?
  neighborhood      String?
  desiredRole       String?
  salaryExpectation String?
  workPreference    String? // "REMOTE" | "HYBRID" | "ONSITE" | "ANY"
  availability      String? // "IMMEDIATE" | "15_DAYS" | "30_DAYS" | "NEGOTIABLE"
  hasCnh            String? // "NONE" | "A" | "B" | "AB" | "C_D_E"
  isPcd             Boolean   @default(false)
  pcdDetails        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  applications  Application[]
  notifications Notification[]
}

model Application {
  id            String    @id @default(cuid())
  jobId         String
  companyId     String
  candidateId   String?
  name          String
  email         String
  phone         String?
  resumeUrl     String?

  /// Dados essenciais copiados do candidato ou capturados na candidatura:
  birthDate         DateTime?
  city              String?
  state             String?
  neighborhood      String?
  desiredRole       String?
  salaryExpectation String?
  workPreference    String?
  availability      String?
  hasCnh            String?
  isPcd             Boolean   @default(false)
  pcdDetails        String?

  status        AppStatus @default(PENDING)
  aiState       AIState   @default(WAITING)
  aiScore       Int?
  aiReasoning   String?
  /// Modelo de IA que gerou aiScore/aiReasoning (ex.: "groq:qwen/qwen3.8-27b").
  aiModel       String?
  /// Checklist por critério da vaga: [{ criterion, met: "sim"|"parcial"|"não", evidence }].
  /// Só explica a nota; não entra no cálculo (o prompt da nota é imutável, regra 3).
  aiChecklist   Json?
  /// Candidatura da sala de simulação: fora de métricas, painel e Inteligência.
  isDemo        Boolean   @default(false)
  /// Cadastro rápido feito pelo gestor (só e-mail): o candidato completa depois.
  preRegistered Boolean   @default(false)
  photoPath     String?
  /// Texto extraído do PDF do currículo — alimenta a busca por conteúdo.
  resumeText    String?
  aiProfile     String?
  /// Segmentação do currículo pela IA: área (ex.: Logística) e nível.
  aiArea        String?
  aiLevel       String?
  /// Análise de perfil sob demanda: áreas em que a pessoa se sairia bem,
  /// nota estimada por área e resumo de onde seria bem aproveitada.
  aiCareer      Json?
  managerNotes  String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  /// Conversa combinada. Uma rodada por candidatura — se um dia houver mais
  /// de uma etapa de entrevista, isto vira um modelo próprio.
  interviewAt       DateTime?
  interviewMode     String? // "Videochamada" | "Presencial" | "Telefone"
  interviewLocation String? // link da chamada, endereço ou telefone

  /// Pré-entrevista: dados pedidos pelo gestor a quem foi aprovado e respondidos
  /// pelo candidato. Só gestores da empresa veem; RG/CPF vão mascarados na ficha.
  maritalStatus       String?
  hasChildren         Boolean?
  childrenCount       Int?
  professionalSummary String?
  rg                  String?
  cpf                 String?
  /// Quais perguntas foram pedidas (chaves de InfoField) e quando.
  infoRequestedFields String[]  @default([])
  infoRequestedAt     DateTime?
  infoAnsweredAt      DateTime?

  job           Job                @relation(fields: [jobId], references: [id], onDelete: Cascade)
  company       Company            @relation(fields: [companyId], references: [id])
  candidate     Candidate?         @relation(fields: [candidateId], references: [id])
  answers       Answer[]
  statusEvents  StatusEvent[]
  notifications Notification[]
  agentRuns     AgentRun[]
  talentItems   TalentFolderItem[]
  talentMatches TalentMatch[]

  @@unique([candidateId, jobId])
  @@index([companyId, status, createdAt])
  @@index([jobId, status])
  @@index([companyId, aiScore])
  @@index([companyId, isDemo])
  @@index([companyId, neighborhood])
  @@index([companyId, desiredRole])
}

/// Novidade do processo na visão do candidato — o mesmo evento que vira
/// trilha e e-mail. Nunca carrega score, raciocínio da IA ou notas do gestor.
model Notification {
  id            String           @id @default(cuid())
  candidateId   String
  applicationId String?
  type          NotificationType
  title         String
  body          String?
  readAt        DateTime?
  createdAt     DateTime         @default(now())

  candidate   Candidate    @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  application Application? @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([candidateId, readAt])
  @@index([applicationId])
}

enum NotificationType {
  APPLICATION_RECEIVED
  STAGE_CHANGED
  INTERVIEW_SCHEDULED
  MANAGER_MESSAGE
  RESULT
  NEW_JOB
  INFO_REQUESTED
}

/// Trilha de mudanças de status — histórico p/ gestor, timeline p/ candidato.
model StatusEvent {
  id            String     @id @default(cuid())
  applicationId String
  from          AppStatus?
  to            AppStatus
  actor         String // "candidato" | "gestor" | "sistema"
  createdAt     DateTime   @default(now())

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId, createdAt])
}

enum AppStatus {
  PENDING
  INTERVIEW
  APPROVED
  REJECTED
}

enum AIState {
  WAITING
  PROCESSING
  DONE
  FAILED
  NO_RESUME
}

model Answer {
  id            String @id @default(cuid())
  applicationId String
  fieldId       String
  value         String

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  field       FormField   @relation(fields: [fieldId], references: [id])

  @@index([applicationId])
  @@index([fieldId])
}

/// Trilha de auditoria — quem fez o quê e quando, por empresa.
model AuditLog {
  id          String   @id @default(cuid())
  companyId   String
  userId      String?
  userEmail   String?
  userName    String?
  action      String
  entityType  String?
  entityId    String?
  entityLabel String?
  metadata    Json?
  createdAt   DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, createdAt(sort: Desc)])
}

model AgentRun {
  id            String         @id @default(cuid())
  companyId     String
  applicationId String?
  agent         AgentType
  eventName     String
  status        AgentRunStatus @default(QUEUED)
  attempts      Int            @default(0)
  durationMs    Int?
  summary       String?
  error         String?
  createdAt     DateTime       @default(now())
  startedAt     DateTime?
  finishedAt    DateTime?

  company     Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  application Application? @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([companyId, createdAt])
  @@index([companyId, agent, status, createdAt])
  @@index([applicationId, createdAt])
}

enum AgentType {
  TRIAGE
  COMMUNICATION
  INTELLIGENCE
}

enum AgentRunStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
}

/// Banco de talentos: pastas por perfil para candidatos que não servem para a
/// vaga em que se inscreveram, mas podem servir para outras.
model TalentFolder {
  id        String   @id @default(cuid())
  companyId String
  name      String
  /// Área do perfil (agrupa as pastas na tela). Ex.: "Logística".
  area      String?
  createdAt DateTime @default(now())

  company Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  items   TalentFolderItem[]

  @@unique([companyId, name])
}

model TalentFolderItem {
  id            String   @id @default(cuid())
  folderId      String
  applicationId String
  addedAt       DateTime @default(now())

  folder      TalentFolder @relation(fields: [folderId], references: [id], onDelete: Cascade)
  application Application  @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@unique([folderId, applicationId])
  @@index([applicationId])
}

/// Stand-by: candidato do banco de talentos analisado contra outra vaga
/// (sem candidatura nova). Só a nota/justificativa da IA; a etapa da
/// candidatura original nunca muda (regra 2).
model TalentMatch {
  id            String   @id @default(cuid())
  companyId     String
  applicationId String
  jobId         String
  score         Int?
  reasoning     String?
  state         AIState  @default(WAITING)
  updatedAt     DateTime @updatedAt

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  job         Job         @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([applicationId, jobId])
  @@index([companyId, jobId])
}

/// Recado do gestor salvo para reuso: assunto + texto com marcadores
/// ({nome}, {empresa}, {vaga}). Um por assunto e por empresa.
model MessageTemplate {
  id         String   @id @default(cuid())
  companyId  String
  subject    String
  /// Assunto normalizado (sem caixa/acento) — identifica o mesmo modelo.
  subjectKey String
  body       String
  useCount   Int      @default(1)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, subjectKey])
}
